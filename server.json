{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.cnrcode/tillpad",
  "title": "Tillpad",
  "description": "Bounded KVP, RAG search, and wipe receipts for agent jobs over remote MCP",
  "version": "0.1.5",
  "websiteUrl": "https://tillpad.dev",
  "repository": {
    "url": "https://github.com/CNR-Consulting/tillpad-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://tillpad.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Tillpad API key as Bearer tp_… (mint in the dashboard)",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "Bearer tp_…"
        }
      ]
    }
  ]
}
